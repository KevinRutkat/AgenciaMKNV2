{
  "name": "agenciamkn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "copy-flags": "node -e \"const fs=require('fs'),path=require('path');fs.copyFileSync('node_modules/flag-icons/css/flag-icons.min.css','public/flag-icons.min.css');function cpDir(src,dst){fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src)){const s=path.join(src,f),d=path.join(dst,f);fs.statSync(s).isDirectory()?cpDir(s,d):fs.copyFileSync(s,d)}}cpDir('node_modules/flag-icons/flags','public/flags')\"",
    "predev": "npm run copy-flags",
    "prebuild": "npm run copy-flags",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test:translation": "node scripts/test-translation.js"
  },
  "dependencies": {
    "@google-cloud/translate": "^9.2.0",
    "@heroicons/react": "^2.2.0",
    "@react-google-maps/api": "^2.20.7",
    "@supabase/supabase-js": "^2.56.0",
    "@types/nodemailer": "^8.0.1",
    "@vercel/analytics": "^2.0.1",
    "flag-icons": "^6.15.0",
    "motion": "^12.40.0",
    "next": "^15.5.19",
    "nodemailer": "^8.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "browserslist": [
    "Chrome >= 91",
    "Edge >= 91",
    "Firefox >= 89",
    "Safari >= 15",
    "iOS >= 15",
    "not dead"
  ]
}
